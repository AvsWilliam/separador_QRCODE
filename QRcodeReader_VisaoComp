
# =========================
# Função para instalar bibliotecas necessárias
# =========================
import subprocess
import sys

def instalar(package):
    # O check_call lança erro se a instalação falhar
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])

# MAPEAMENTO: "nome_no_import": "nome_no_pip"
libraries = {
    "cv2": "opencv-python",
    "numpy": "numpy",
    "pandas": "pandas",
    "ultralytics": "ultralytics",
    "time": "time"
}

for import_name, install_name in libraries.items():
    try:
        __import__(import_name)
    except ImportError:
        print(f"Biblioteca {import_name} não encontrada. Instalando {install_name}...")
        instalar(install_name)

import cv2
from ultralytics import YOLO
import time


# =========================
# CONFIGURAÇÃO CÂMERA (IP)
# =========================
def ip_config_celular ():
    print("CONFIGURAÇÃO DE IP PARA CÂMERA DO CELULAR")
    if(1):
        print("CONFIGURAÇÃO PARA CÂMERA 1")
        ip_1 = input("Digite o IP da sua camera QR Code (DroidCam): ")
        porta_1 = input("Digite a porta da sua camera QR Code (DroidCam): ")
    if(2):
        print("CONFIGURAÇÃO PARA CÂMERA 2")
        ip_2 = input("Digite o IP da sua camera QR Code (DroidCam): ")
        porta_2 = input("Digite a porta da sua camera QR Code (DroidCam): ")
    return ip_1, ip_2, porta_1, porta_2

# Verifique o IP no app DroidCam do seu celular
ip_celular_1, ip_celular_2, porta_1, porta_2 = ip_config_celular()



url_1 = f"http://{ip_celular_1}:{porta_1}/video"
url_2 = f"http://{ip_celular_2}:{porta_2}/video"

# =========================
# SETUP MODELOS E CAMERA
# =========================
print(f"Conectando ao DroidCam em: {url_1}")
cap = cv2.VideoCapture(url_1)
print(f"Conectando ao DroidCam em: {url_2}")
cap2 = cv2.VideoCapture(url_2)

# Carrega YOLO e Detector de QR Code
modelo_yolo = YOLO("yolov8n.pt")
detector_qr = cv2.QRCodeDetector()

# Contadores e Estados
contador_objetos = 0
detectando_yolo = False
ultimo_tempo_yolo = 0
ultimo_qr_lido = ""
ultimo_tempo_qr = 0

print("\n--- SISTEMA INICIADO ---")
print("Detectando Objetos Grandes e QR Codes...")

# =========================
# LOOP PRINCIPAL
# =========================
while True:
    # Captura das DUAS câmeras
    ret1, frame1 = cap.read()
    ret2, frame2 = cap2.read()

    if not ret1 or not ret2:
        print("Erro de conexão com uma das câmeras.")
        break

    # Processar cada frame em uma lista para facilitar
    frames = [frame1, frame2]
    cameras_nomes = ["Camera 1", "Camera 2"]
    
    tempo_atual = time.time()

    for i, frame in enumerate(frames):
        # 1. Redimensiona para fluidez
        frame = cv2.resize(frame, (640, 480))

        # --- LÓGICA DO QR CODE ---
        dados_qr, bbox_qr, _ = detector_qr.detectAndDecode(frame)
        if bbox_qr is not None and dados_qr:
            # Desenha o QR Code
            pts = bbox_qr.astype(int)
            cv2.polylines(frame, [pts], True, (255, 0, 0), 2)
            
            if dados_qr != ultimo_qr_lido or (tempo_atual - ultimo_tempo_qr > 2):
                print(f"[{cameras_nomes[i]}] QR Code: {dados_qr}")
                ultimo_qr_lido = dados_qr
                ultimo_tempo_qr = tempo_atual

        # --- LÓGICA DO YOLO ---
        resultados = modelo_yolo(frame, verbose=False)
        objeto_grande_agora = False

        for r in resultados:
            for box in r.boxes:
                x1, y1, x2, y2 = map(int, box.xyxy[0])
                area = (x2 - x1) * (y2 - y1)
                if area > 30000:
                    objeto_grande_agora = True
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)

        # Lógica de contagem (Simplificada para o exemplo)
        if objeto_grande_agora and not detectando_yolo:
             contador_objetos += 1
             print(f"Objeto detectado na {cameras_nomes[i]}! Total: {contador_objetos}")
             detectando_yolo = True
        elif not objeto_grande_agora:
             detectando_yolo = False

        # Status na tela de cada frame
        cv2.putText(frame, f"{cameras_nomes[i]} - Objetos: {contador_objetos}", (20, 40), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

        # Mostra as janelas separadas
        cv2.imshow(cameras_nomes[i], frame)

    if cv2.waitKey(1) == 27: # ESC para fechar
        break

cap.release()
cap2.release()
cv2.destroyAllWindows()
