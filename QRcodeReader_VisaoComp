import subprocess
import sys
import time

# =========================
# Função para instalar bibliotecas necessárias
# =========================
def instalar(package):
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])

libraries = {
    "cv2": "opencv-python",
    "numpy": "numpy",
    "pandas": "pandas",
    "ultralytics": "ultralytics",
    "lapx" : "lapx",
    "threading": "threading"
}

for import_name, install_name in libraries.items():
    try:
        __import__(import_name)
    except ImportError:
        print(f"Biblioteca {import_name} não encontrada. Instalando {install_name}...")
        instalar(install_name)

import cv2
from ultralytics import YOLO
import threading

# =========================
# CONFIGURAÇÃO CÂMERA (IP)
# =========================
def ip_config_celular ():
    print("CONFIGURAÇÃO DE IP PARA CÂMERA DO CELULAR")
    ip_1 = input("Digite o IP da Câmera 1 (DroidCam): ")
    porta_1 = input("Digite a porta da Câmera 1 (DroidCam): ")
    ip_2 = input("Digite o IP da Câmera 2 (DroidCam): ")
    porta_2 = input("Digite a porta da Câmera 2 (DroidCam): ")
    return ip_1, ip_2, porta_1, porta_2

ip_celular_1, ip_celular_2, porta_1, porta_2 = ip_config_celular()

url_1 = f"http://{ip_celular_1}:{porta_1}/video"
url_2 = f"http://{ip_celular_2}:{porta_2}/video"


# ==========================================
# DEFINIÇÕES DE BUFFER PARA DELAY (THREADING)
# ==========================================
class VideoStream:
    def __init__(self, src):
        self.cap = cv2.VideoCapture(src)
        self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        self.ret, self.frame = self.cap.read()
        self.stopped = False

    def start(self):
        threading.Thread(target=self.update, args=(), daemon=True).start()
        return self

    def update(self):
        while not self.stopped:
            ret, frame = self.cap.read()
            if ret:
                self.ret, self.frame = ret, frame

    def read(self):
        return self.ret, self.frame

    def release(self):
        self.stopped = True
        self.cap.release()

# =========================
# SETUP MODELOS E CAMERA
# =========================
try:
    cap = cv2.VideoCapture(url_1)
    cap2 = cv2.VideoCapture(url_2)
except Exception as e:
    print(f"Erro ao conectar: {e}")
    sys.exit(1)

# Carrega YOLO (Modelo de detecção com rastreamento)
modelo_yolo = YOLO("yolov8n.pt")
detector_qr = cv2.QRCodeDetector()

# --- VARIÁVEIS DE CONTROLE DE RASTREAMENTO ---
contador_objetos = 0
ids_ja_contados = set() # Guarda os IDs que a IA já processou
ultimo_qr_lido = ""
ultimo_tempo_qr = 0

print("\n--- SISTEMA INICIADO COM RASTREAMENTO (TRACKING) ---")

# =========================
# LOOP PRINCIPAL
# =========================
while True:
    ret1, frame1 = cap.read()
    ret2, frame2 = cap2.read()

    if not ret1 or not ret2:
        print("Erro de conexão.")
        break

    frames = [frame1, frame2]
    cameras_nomes = ["Camera 1", "Camera 2"]
    tempo_atual = time.time()

    for i, frame in enumerate(frames):
        frame = cv2.resize(frame, (640, 480))

        # --- LÓGICA DO QR CODE ---
        dados_qr, bbox_qr, _ = detector_qr.detectAndDecode(frame)
        if bbox_qr is not None and dados_qr:
            pts = bbox_qr.astype(int)
            cv2.polylines(frame, [pts], True, (255, 0, 0), 2)
            if dados_qr != ultimo_qr_lido or (tempo_atual - ultimo_tempo_qr > 3):
                print(f"[{cameras_nomes[i]}] QR Lido: {dados_qr}")
                ultimo_qr_lido = dados_qr
                ultimo_tempo_qr = tempo_atual

        # --- LÓGICA DO YOLO COM TRACKING ---
        # persist=True mantém o ID mesmo que o objeto suma por alguns frames
        resultados = modelo_yolo.track(frame, persist=True, verbose=False, conf=0.5, iou=0.5)

        if resultados[0].boxes.id is not None:
            # Pegamos os IDs e as coordenadas das caixas
            boxes = resultados[0].boxes.xyxy.cpu().numpy().astype(int)
            ids = resultados[0].boxes.id.cpu().numpy().astype(int)

            for box, obj_id in zip(boxes, ids):
                x1, y1, x2, y2 = box
                area = (x2 - x1) * (y2 - y1)

                # Se for um objeto grande e o ID ainda não foi contado
                if area > 50000:
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                    cv2.putText(frame, f"ID: {obj_id}", (x1, y1 - 10), 
                                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

                    if obj_id not in ids_ja_contados:
                        contador_objetos += 1
                        ids_ja_contados.add(obj_id)
                        print(f"Novo Objeto Detectado! ID: {obj_id} | Total: {contador_objetos}")

        # Interface
        cv2.putText(frame, f"Total Pecas: {contador_objetos}", (20, 40), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
        cv2.imshow(cameras_nomes[i], frame)

    if cv2.waitKey(1) == 27:
        break

cap.release()
cap2.release()
cv2.destroyAllWindows()